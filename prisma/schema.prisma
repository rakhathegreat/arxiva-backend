// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

/// Role of the user in the system.
enum Role {
  ADMIN
  INTERNAL
  MITRA
}

/// Current physical status of an item.
enum Status {
  tersedia /// Item is available and in good condition
  digunakan /// Item is currently in use or deployed
  rusak /// Item is damaged
  hilang /// Item is lost
}

/// Category of the notification for the user.
enum NotificationType {
  SYSTEM
  REQUEST
  STOCK_IN
  STOCK_OUT
  STOCK_LOW
}

/// Category for transaction logs to track the movement or status change of an item.
enum MutationType {
  MASUK /// Item entering inventory
  KELUAR /// Item leaving inventory
  RUSAK /// Item marked as damaged
  HILANG /// Item marked as lost
}

/// Defines the hierarchical type of a location.
enum LocationType {
  BRANCH /// Main branch office
  PARTNER /// External partner location
  RACK /// Physical rack within a branch/partner
  BOX /// Box within a rack
  PALLET /// Pallet for bulk storage
}

/// Type of entity referenced by a notification.
enum ReferenceType {
  ITEM
  ITEM_MUTATION
  LOCATION
  USER
}

/// Status lifecycle of an item request.
enum RequestStatus {
  DRAFT /// Draft request@
  MENUNGGU /// Waiting for approval
  SIAP /// Ready to take
  DISETUJUI /// Approved (return-rusak only)
  SERAH /// Handed over physically (return-rusak only)
  DITERIMA /// Received by partner/requester
  SELESAI /// Request fully completed
  DITOLAK /// Rejected
  DIBATALKAN /// Cancelled by the requester
}

/// Direction/kind of a request.
enum RequestType {
  OUTGOING /// Default: partner requests material FROM KP
  RETURN_RUSAK /// Partner returns damaged material TO KP
  INTER_MITRA /// Peer transfer: mate requests material FROM another mitra
}

/// Status for a signature session captured via mobile QR
enum SessionStatus {
  PENDING
  COMPLETED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

/// Core user account representing both system admins and partners.
model User {
  id                 String  @id @default(uuid())
  username           String  @unique
  password           String
  role               Role    @default(MITRA)
  isAktif            Boolean @default(true) /// Soft delete/disable flag
  googleConnected    Boolean @default(false)
  googleEmail        String?
  googleAccessToken  String? @db.Text
  googleRefreshToken String? @db.Text

  profile UserProfile?

  items         Item[]
  itemMutations ItemMutation[]
  notifications Notification[]
  locations     UserLocation[]

  requests           Request[]           @relation("Requester")
  destinedRequests   Request[]           @relation("Destination")
  providedRequests   Request[]           @relation("Provider")
  allocatedRequests  RequestAllocation[] @relation("Allocator")
  generatedDocuments DeliveryDocument[]  @relation("GeneratedDocument")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Detailed profile information for a User.
model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String
  nama          String
  telepon       String
  alamat        String
  code          String? /// Unique partner identification code
  partnerType   String?
  contactPerson String?
  picName       String?
  picSignatureUrl String? @db.LongText
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Master category for grouping related items (e.g., Laptops, Monitors).
model MaterialCategory {
  id Int @id @default(autoincrement())

  nama   String

  safetyStock Int @default(0) /// Minimum stock threshold before low stock alert

  models MaterialModel[]

  requestItems RequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Brand or manufacturer associated with a Category.
model Brand {
  id         Int    @id @default(autoincrement())
  nama       String @unique
  origin     String /// Country or region of origin
  identifier String @unique /// Code or slug used for generation/tracking

  models        MaterialModel[]
  locationRules BrandLocationRule[]

  requestItems RequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaterialModel {
  id   Int    @id @default(autoincrement())
  code String @unique
  nama String @unique

  /// Keterangan bebas tentang model material ini.
  deskripsi String?

  materialCategoryId Int
  materialCategory   MaterialCategory @relation(fields: [materialCategoryId], references: [id])

  brandId Int
  brand   Brand @relation(fields: [brandId], references: [id])

  items Item[]
  requestItems RequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([materialCategoryId])
}

/// System and operational notifications for users.
model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    NotificationType @default(SYSTEM)

  isRead Boolean @default(false)

  referenceId   String? /// Polymorphic relation ID
  referenceType ReferenceType? /// Polymorphic relation type

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

/// Represents a single physical asset in the inventory system.
model Item {
  id String @id @default(uuid())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  serialNumber String @unique /// Unique hardware serial number

  modelId Int
  model   MaterialModel @relation(fields: [modelId], references: [id])

  status Status @default(tersedia)

  kondisi String @default("Baru")

  paNumber String? /// Property/Asset number assigned by organization
  ticket   String? /// Trouble ticket reference for damaged items
  catatan  String? /// Damage/condition notes for damaged items

  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id])

  entryDate DateTime /// Date item was received into inventory
  exitDate  DateTime? /// Date item left inventory or was deployed

  mutations ItemMutation[]

  requestAllocations RequestAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modelId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([locationId])
}

/// Audit log for item movements and status changes.
model ItemMutation {
  id String @id @default(uuid())

  mutationNumber String?      @unique
  type           MutationType

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String /// User who performed the transaction
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  serialNumber String /// Snapshotted serial number
  brand        String /// Snapshotted brand
  category     String /// Snapshotted category
  paNumber     String /// Snapshotted Property/Asset number
  ticket       String? /// Snapshotted trouble ticket reference

  originLocationId      Int?
  destinationLocationId Int?
  
  originLocationName      String?
  destinationLocationName String?

  originLocation      Location? @relation("OriginLocation", fields: [originLocationId], references: [id])
  destinationLocation Location? @relation("DestinationLocation", fields: [destinationLocationId], references: [id])

  requestId String?
  request   Request? @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([requestId])
}

/// Physical or logical storage location (hierarchical).
model Location {
  id       Int          @id @default(autoincrement())
  name     String
  type     LocationType
  capacity Int          @default(0) /// Maximum items allowed
  code     String?      @unique

  parentId Int?
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Location[] @relation("LocationHierarchy")

  isActive Boolean @default(true)

  /// Link Google Spreadsheet untuk QR code lokasi (fitur Google Drive).
  sheetId  String?
  sheetUrl String?

  items         Item[]
  userLocations UserLocation[]

  brandRules BrandLocationRule[]

  originMutations ItemMutation[] @relation("OriginLocation")

  destinationMutations ItemMutation[] @relation("DestinationLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
  @@index([type])
}

/// Join table for associating users with specific locations.
model UserLocation {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, locationId])
}

/// Rules restricting which brands can be stored in which locations.
model BrandLocationRule {
  id Int @id @default(autoincrement())

  brandId Int
  brand   Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([brandId, locationId])
}

/// Request for items made by a partner or branch.
model Request {
  id String @id @default(uuid())

  requestNumber String @unique

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  destinationUserId String?
  destinationUser   User?  @relation("Destination", fields: [destinationUserId], references: [id])

  providerPartnerId String?
  providerPartner   User?  @relation("Provider", fields: [providerPartnerId], references: [id])

  status RequestStatus @default(MENUNGGU)

  type RequestType @default(OUTGOING)

  notes String?

  rejectionNotes String? /// Admin note recorded when the request is rejected or cancelled

  requestedAt DateTime @default(now())

  approvedAt DateTime?

  processedAt DateTime?

  shippedAt DateTime?

  receivedAt DateTime?

  completedAt DateTime?

  requestItems  RequestItem[]
  itemMutations ItemMutation[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deliveryDocument DeliveryDocument?

  @@index([requesterId])
  @@index([status])
  @@index([destinationUserId])
  @@index([providerPartnerId])
}

/// Specific requested quantity of a category/brand within a Request.
model RequestItem {
  id String @id @default(uuid())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  materialCategoryId Int
  materialCategory   MaterialCategory @relation(fields: [materialCategoryId], references: [id])

  brandId Int?
  brand   Brand? @relation(fields: [brandId], references: [id])

  modelId Int?
  model   MaterialModel? @relation(fields: [modelId], references: [id])

  quantity Int

  fulfilledQuantity Int @default(0) /// Tracks how many items have been allocated

  serialNumber String? /// Specific SN returned (RETURN_RUSAK); null = consumable/generic

  donorSerialNumbers String? /// Comma-joined SNs scanned by provider (INTER_MITRA)
  receiverSerialNumbers String? /// Comma-joined SNs scanned by receiver (INTER_MITRA)
  donorScannedAt DateTime?
  receiverScannedAt DateTime?

  allocations RequestAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
}

/// Join table mapping specific physical items to a fulfilled RequestItem.
model RequestAllocation {
  id String @id @default(uuid())

  requestItemId String
  requestItem   RequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  allocatedById String
  allocatedBy   User   @relation("Allocator", fields: [allocatedById], references: [id])

  allocatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([itemId])
}

/// Official generated document (e.g., Berita Acara Serah Terima) for a request.
model DeliveryDocument {
  id String @id @default(uuid())

  requestId String @unique

  request Request @relation(fields: [requestId], references: [id])

  documentNumber String @unique

  filePath           String? /// Local path to unsigned BAST draft PDF
  finalFilePath      String? /// Local path to signed BAST final PDF
  driveFileId        String? /// File ID in Google Drive
  driveViewUrl       String? @db.Text /// Shared view URL in Google Drive

  generatedById String
  generatedBy   User   @relation("GeneratedDocument", fields: [generatedById], references: [id])

  generatedAt DateTime @default(now())

  signedAt DateTime?
  kpSignedAt DateTime?
  kpSignedById String?
  kpName String?
  kpSignatureUrl String? @db.LongText
  picSignedAt DateTime?
  picSignedById String?
  signerName String?
  signerSignatureUrl String? @db.LongText
  itemsSnapshot String? @db.LongText

  createdAt DateTime @default(now())
}

/// Temporary session for mobile QR code signature capture
model SignatureSession {
  id           String        @id @default(uuid())
  status       SessionStatus @default(PENDING)
  signatureUrl String?       @db.LongText
  signerName   String?
  requestId    String?
  userId       String?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Daily reconciliation record for a distributed item (1 record per item per day).
model ReconRecord {
  id        String   @id @default(uuid())
  itemId    String
  userId    String
  /// Working day of the mitra (YYYY-MM-DD); source of truth for "last recon date".
  date      String
  /// Public MinIO URL of the recon photo.
  imageUrl  String
  /// Actual timestamp when the mitra took the photo (device time, nullable for legacy records).
  capturedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([itemId, date])
  @@index([userId])
  @@index([date])
}

/// Key-value store for system-wide configuration (e.g., Google Drive Folder ID).
model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
