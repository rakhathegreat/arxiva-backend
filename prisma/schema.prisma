// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum Role {
  ADMIN
  MITRA
}

enum Status {
  tersedia
  digunakan
  rusak
  hilang
}

enum NotificationType {
  SYSTEM
  REQUEST
  STOCK_IN
  STOCK_OUT
  STOCK_LOW
}

enum TransactionCategory {
  MASUK
  KELUAR
  RUSAK
  HILANG
}

enum LocationType {
  BRANCH
  PARTNER
  RACK
  BOX
  PALLET
}

enum ReferenceType {
  ITEM
  TRANSACTION
  LOCATION
  USER
}

enum RequestStatus {
  DRAFT
  MENUNGGU
  DISETUJUI
  DIPROSES
  DIKIRIM
  DITERIMA
  SELESAI
  DITOLAK
  DIBATALKAN
}

// MODELS

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  password           String
  role               Role     @default(MITRA)
  isAktif            Boolean  @default(true)
  googleConnected    Boolean  @default(false)
  googleEmail        String?
  googleAccessToken  String?  @db.Text
  googleRefreshToken String?  @db.Text

  profile   UserProfile?

  items          Item[]
  transactions   Transaction[]
  notifications  Notification[]
  locations      UserLocation[]

  requests            Request[]             @relation("Requester")
  allocatedRequests   RequestAllocation[]   @relation("Allocator")
  generatedDocuments  DeliveryDocument[]    @relation("GeneratedDocument")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String
  nama          String
  telepon       String
  alamat        String
  code          String?
  partnerType   String?
  contactPerson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  nama        String
  deskripsi   String?
  safetyStock Int      @default(0)

  brands      Brand[]
  items       Item[]

  requestItems RequestItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt 
}

model Brand {
  id            Int      @id @default(autoincrement())
  nama          String   @unique
  origin        String
  identifier    String   @unique

  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id])

  items         Item[]
  locationRules BrandLocationRule[]

  requestItems  RequestItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt 
}

model Notification {
  id            String            @id @default(uuid())

  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  message       String
  type          NotificationType  @default(SYSTEM)

  isRead        Boolean           @default(false)

  referenceId   String?
  referenceType ReferenceType?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt 

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Item {
  id                String   @id @default(uuid())

  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  serialNumber      String   @unique

  categoryId        Int
  category          Category  @relation(fields: [categoryId], references: [id])

  brandId           Int
  brand             Brand  @relation(fields: [brandId], references: [id])

  status            Status    @default(tersedia)

  paNumber          String?

  locationId        Int?
  location          Location?  @relation(fields: [locationId], references: [id])

  entryDate         DateTime
  exitDate          DateTime?

  transactions       Transaction[]

  requestAllocations RequestAllocation[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([locationId])
}

model Transaction {
  id                    String              @id @default(uuid())
  
  transactionNumber     String?              @unique
  transactionType       TransactionCategory

  itemId                String
  item                  Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  serialNumber          String
  brand                 String
  category              String
  paNumber              String

  originLocationId      Int?
  destinationLocationId Int?


  originLocation        Location?           @relation("OriginLocation", fields: [originLocationId],references: [id])
  destinationLocation   Location?           @relation("DestinationLocation", fields: [destinationLocationId], references: [id])

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt 

  @@index([userId])
  @@index([createdAt])
}

model Location {
  id            Int           @id     @default(autoincrement())
  name          String        @unique
  type          LocationType
  capacity      Int           @default(0)
  code          String?        @unique  


  parentId      Int?
  parent        Location?     @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Location[]    @relation("LocationHierarchy")

  isActive      Boolean       @default(true)

  items         Item[]
  userLocations UserLocation[]

  brandRules    BrandLocationRule[]

  originTransactions      Transaction[]   @relation("OriginLocation")

  destinationTransactions Transaction[]   @relation("DestinationLocation")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt 

  @@index([parentId])
  @@index([type])
}

model UserLocation {
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)


  locationId  Int
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt 

  @@id([userId, locationId])
}

model BrandLocationRule {
  id Int @id @default(autoincrement())

  brandId Int
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  locationId Int
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([brandId, locationId])
}

model Request {
  id            String @id @default(uuid())

  requestNumber String @unique

  requesterId   String
  requester     User @relation(fields: [requesterId], references: [id])

  status        RequestStatus @default(MENUNGGU)

  notes         String?

  requestedAt   DateTime @default(now())

  approvedAt    DateTime?

  processedAt   DateTime?

  shippedAt     DateTime?

  receivedAt    DateTime?

  completedAt   DateTime?

  requestItems  RequestItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
}

model RequestItem {
  id String @id @default(uuid())

  requestId String
  request Request
      @relation(fields: [requestId], references: [id], onDelete: Cascade)

  categoryId Int
  category Category
      @relation(fields: [categoryId], references: [id])

  brandId Int?
  brand Brand?
      @relation(fields: [brandId], references: [id])

  quantity Int

  fulfilledQuantity Int @default(0)

  allocations RequestAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
}

model RequestAllocation {

  id String @id @default(uuid())

  requestItemId String
  requestItem RequestItem
      @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  itemId String
  item Item
      @relation(fields: [itemId], references: [id])

  allocatedById String
  allocatedBy User
      @relation(fields: [allocatedById], references: [id])

  allocatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([requestItemId, itemId])
}

model DeliveryDocument {

  id String @id @default(uuid())

  requestId String @unique

  request Request
      @relation(fields: [requestId], references: [id])

  documentNumber String @unique

  filePath String

  generatedById String

  generatedBy User
      @relation(fields: [generatedById], references: [id])

  generatedAt DateTime @default(now())

  signedAt DateTime?

  createdAt DateTime @default(now())
}