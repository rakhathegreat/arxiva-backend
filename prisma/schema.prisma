// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MITRA
}

enum Status {
  tersedia
  digunakan
  rusak
  hilang
}

enum NotificationType {
  SYSTEM
  REQUEST
  STOCK_IN
  STOCK_OUT
  STOCK_LOW
}

enum TransactionCategory {
  MASUK
  KELUAR
  RUSAK
  HILANG
}

enum LocationType {
  BRANCH
  PARTNER
  RACK
  BOX
  PALLET
}

enum ReferenceType {
  ITEM
  TRANSACTION
  LOCATION
  USER
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  password           String
  role               Role     @default(MITRA)
  isAktif            Boolean  @default(true)
  googleConnected    Boolean  @default(false)
  googleEmail        String?
  googleAccessToken  String?  @db.Text
  googleRefreshToken String?  @db.Text

  profile   UserProfile?

  items          Item[]
  transactions   Transaction[]
  notifications  Notification[]
  locations      UserLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String
  nama          String
  telepon       String
  alamat        String
  code          String?
  partnerType   String?
  contactPerson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  nama        String
  deskripsi   String?
  safetyStock Int      @default(0)

  brands      Brand[]
  items       Item[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt 
}

model Brand {
  id            Int      @id @default(autoincrement())
  nama          String   @unique
  origin        String
  identifier    String   @unique

  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id])

  items         Item[]
  locationRules BrandLocationRule[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt 
}

model Notification {
  id            String            @id @default(uuid())

  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  message       String
  type          NotificationType  @default(SYSTEM)

  isRead        Boolean           @default(false)

  referenceId   String?
  referenceType ReferenceType?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt 

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Item {
  id                String   @id @default(uuid())

  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  serialNumber      String   @unique

  categoryId        Int
  category          Category  @relation(fields: [categoryId], references: [id])

  brandId           Int
  brand             Brand  @relation(fields: [brandId], references: [id])

  status            Status    @default(tersedia)

  paNumber          String?

  locationId        Int?
  location          Location?  @relation(fields: [locationId], references: [id])

  entryDate         DateTime
  exitDate          DateTime?

  transactions       Transaction[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([locationId])
}

model Transaction {
  id                    String              @id @default(uuid())
  
  transactionNumber     String?              @unique
  transactionType       TransactionCategory

  itemId                String
  item                  Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  serialNumber          String
  brand                 String
  category              String
  paNumber              String

  originLocationId      Int?
  destinationLocationId Int?


  originLocation        Location?           @relation("OriginLocation", fields: [originLocationId],references: [id])
  destinationLocation   Location?           @relation("DestinationLocation", fields: [destinationLocationId], references: [id])

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt 

  @@index([userId])
  @@index([createdAt])
}

model Location {
  id            Int           @id     @default(autoincrement())
  name          String        @unique
  type          LocationType
  capacity      Int           @default(0)
  code          String?        @unique  


  parentId      Int?
  parent        Location?     @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Location[]    @relation("LocationHierarchy")

  isActive      Boolean       @default(true)

  items         Item[]
  userLocations UserLocation[]

  brandRules    BrandLocationRule[]

  originTransactions      Transaction[]   @relation("OriginLocation")

  destinationTransactions Transaction[]   @relation("DestinationLocation")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt 

  @@index([parentId])
  @@index([type])
}

model UserLocation {
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)


  locationId  Int
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt 

  @@id([userId, locationId])
}

model BrandLocationRule {
  id Int @id @default(autoincrement())

  brandId Int
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  locationId Int
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([brandId, locationId])
}