# Database connection URL for Prisma #
DATABASE_URL=

# Kredensial service MariaDB di docker-compose.yml #
# Dipakai untuk inisialisasi DB dan untuk menyusun DATABASE_URL backend.
# Password harus URL-safe (hindari @ : / ? #) karena dirangkai jadi URL.
# Mengubah MYSQL_ROOT_PASSWORD/MYSQL_PASSWORD di sini TIDAK mengubah password
# user yang sudah ada di volume mariadb_data — lihat docs/DEPLOYMENT.md.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=arxiva
MYSQL_USER=admin
MYSQL_PASSWORD=

## JWT secret key for signing and verifying JSON Web Tokens #
JWT_SECRET=

# Server configuration #
NODE_ENV=development
HOST=
PORT=

# Keamanan #
# Daftar origin browser yang diizinkan, pisahkan dengan koma.
# Wajib diisi di production; kosong = tidak ada origin browser yang diizinkan.
# Klien desktop/mobile Tauri tidak mengirim Origin sehingga tidak terpengaruh.
CORS_ORIGINS=
# Jumlah hop reverse proxy tepercaya (Caddy = 1) agar IP klien terbaca benar.
TRUST_PROXY=0
# Batas ukuran body JSON/urlencoded.
BODY_LIMIT=2mb
# Rate limiting (set RATE_LIMIT_DISABLED=true untuk mematikan, mis. saat load test).
RATE_LIMIT_DISABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# Google OAuth2 credentials #
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Harus menunjuk ke endpoint callback backend, dapat dijangkau browser user:
GOOGLE_REDIRECT_URI=http://<ip-atau-domain-backend>:3000/auth/google/callback
ROOT_FOLDER_ID=

# Enable Swagger documentation #
# Biarkan false di production: /api-docs membeberkan seluruh kontrak API.
ENABLE_SWAGGER=false

# Tag image backend yang dipakai docker compose (kosong = latest).
# Diisi otomatis oleh pipeline deploy; untuk rollback manual:
#   IMAGE_TAG=sha-<git-sha> docker compose up -d --force-recreate backend
IMAGE_TAG=

# S3 Object Storage (RustFS) #
# STORAGE_PUBLIC_URL = base URL tanpa bucket name. Code akan append /${bucket}/${objectName}.
# Contoh: https://api-taslim.duckdns.org/storage  →  https://api-taslim.duckdns.org/storage/arxiva-images/images/...
# Di docker compose, STORAGE_ENDPOINT di-override menjadi `rustfs` (nama service).
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1
# Kredensial ini dipakai RustFS sebagai RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY.
# Wajib diisi (production menolak start bila kosong).
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=
STORAGE_BUCKET=arxiva-images
STORAGE_PUBLIC_URL=https://api-taslim.duckdns.org/storage