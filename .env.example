# Database connection URL for Prisma #
DATABASE_URL=

## JWT secret key for signing and verifying JSON Web Tokens #
JWT_SECRET=

# Server configuration #
HOST=
PORT=

# Google OAuth2 credentials #
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Harus menunjuk ke endpoint callback backend, dapat dijangkau browser user:
GOOGLE_REDIRECT_URI=http://<ip-atau-domain-backend>:3000/auth/google/callback
ROOT_FOLDER_ID=

# Enable Swagger documentation #
ENABLE_SWAGGER=