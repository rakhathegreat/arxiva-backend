# Database connection URL for Prisma #
DATABASE_URL=

## JWT secret key for signing and verifying JSON Web Tokens #
JWT_SECRET=

# Server configuration #
HOST=
PORT=

# Google OAuth2 credentials #
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Harus menunjuk ke endpoint callback backend, dapat dijangkau browser user:
GOOGLE_REDIRECT_URI=http://<ip-atau-domain-backend>:3000/auth/google/callback
ROOT_FOLDER_ID=

# Enable Swagger documentation #
ENABLE_SWAGGER=

# MinIO S3 Object Storage #
# MINIO_PUBLIC_URL = base URL tanpa bucket name. Code akan append /${bucket}/${objectName}.
# Contoh: https://api-taslim.duckdns.org/minio  →  https://api-taslim.duckdns.org/minio/arxiva-images/images/...
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=arxiva-images
MINIO_PUBLIC_URL=https://api-taslim.duckdns.org/minio